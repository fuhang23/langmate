# LangMate 环境变量配置
# 复制为 .env 并填入真实值（或用系统环境变量加载）

# 必填：主模型（DeepSeek）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# Phase 2（语音）需要：语音转文字 ASR（可选 groq / openai / xiaomi_mimo）
# 免费额度较多、低延迟首选 groq
GROQ_API_KEY=gsk_你的Groq密钥

# Phase 2（语音）需要：豆包/火山引擎 TTS（语音合成）
VOLCENGINE_APP_ID=你的火山引擎应用ID
VOLCENGINE_ACCESS_TOKEN=你的火山引擎访问令牌
VOLCENGINE_CLUSTER=volcano_tts

# Phase 3 需要：口语评分（豆包语音评测 或 Azure Speech）
# 可选，先用 DeepSeek 文本评分兜底
