# LangMate 环境变量配置
# 复制为 .env 并填入真实值（或用系统环境变量加载）

# 必填：主模型（DeepSeek）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 语音输入 ASR：siliconflow（硅基流动，国内，OpenAI 兼容）
# 控制台：https://cloud.siliconflow.cn  → API 密钥
SILICONFLOW_API_KEY=sk-你的SiliconFlow密钥

# 备用 ASR（可选）：groq
GROQ_API_KEY=gsk_你的Groq密钥

# 语音输出 TTS：豆包/火山引擎
# 控制台：https://console.volcengine.com/speech → 语音合成大模型
VOLCENGINE_APP_ID=你的火山引擎应用ID
VOLCENGINE_ACCESS_TOKEN=你的火山引擎访问令牌
VOLCENGINE_CLUSTER=volcano_tts

# 发音评测：有道智云语音评测（CAPT）
# 控制台：https://ai.youdao.com → 应用管理创建应用 → 开通「语音评测」
YOUDAO_APP_KEY=你的有道应用ID
YOUDAO_APP_SECRET=你的有道应用密钥
