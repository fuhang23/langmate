{
  "providers": {
    "deepseek": {
      "apiKey": "${DEEPSEEK_API_KEY}"
    },
    "groq": {
      "apiKey": "${GROQ_API_KEY}"
    }
  },
  "modelPresets": {
    "primary": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "maxTokens": 4096,
      "contextWindowTokens": 64000,
      "temperature": 0.7
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "primary",
      "workspace": "workspace",
      "timezone": "Asia/Shanghai"
    }
  },
  "transcription": {
    "enabled": false,
    "provider": "groq",
    "language": "en"
  },
  "channels": {
    "websocket": {
      "enabled": true
    }
  }
}
