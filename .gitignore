# ==== 密钥（绝对不能提交）====
.env
*.env.local

# 含 API Key 等的本地配置，不提交（用 config.json.example 作模板）
app/config.json

# ==== Python 运行产物 ====
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ==== nanobot 构建产物 / 前端依赖 ====
app/nanobot/nanobot/web/dist/
app/nanobot/webui/node_modules/
app/nanobot/.venv/

# ==== WorkBuddy 工具的项目数据（含个人记录，忽略）====
.workbuddy/

# ==== 本地资料知识库（版权资料，不提交）====
app/workspace/knowledge/
app/workspace/skills-reference/

# ==== 系统 / 编辑器 ====
.DS_Store
Thumbs.db
.idea/
.vscode/

# 输入法等程序误写入的残留目录（未展开环境变量 %SystemDrive% 作为字面文件夹名，如 %SystemDrive%/ProgramData/SogouInput）
%SystemDrive%/

# nanobot 运行时数据（会话/媒体/CLI apps）
app/sessions/
app/media/
app/cli-apps/

# nanobot 记忆系统与自动生成的文件（保留 skills/）
app/workspace/memory/
app/workspace/SOUL.md
app/workspace/USER.md
app/workspace/AGENTS.md
app/workspace/HEARTBEAT.md
app/workspace/prompts/
app/workspace/.nanobot/

# nanobot 运行时 WebUI 状态
app/webui/
# IDE / AI 工具配置
.codebuddy/
.trae/

# LangMate 学习进度数据库（SQLite，运行时生成）
app/data/

.commit-msg-tmp
